{
  "schema_version": 1,
  "id": "arthas",
  "name": "Arthas",
  "role": "Tank",
  "overview": "Arthas is a Tank who relies on Roots and Slows to peel for his team or to stop enemy Heroes from retreating. This type of crowd-control is great against melee Heroes that rely on Basic Attacks and lack mobility.",
  "strengths": [
    "Powerful crowd control",
    "Good self-sustain",
    "Counters melee Heroes that rely on Basic Attacks",
    "Solid damage output",
    "Durable against burst damage"
  ],
  "weaknesses": [
    "Weak engage with Howling Blast",
    "No mobility",
    "Weak to Displacement effects",
    "Consumes a lot of Mana with Frozen Tempest",
    "Suffers against healing reduction effects",
    "Weak to kite"
  ],
