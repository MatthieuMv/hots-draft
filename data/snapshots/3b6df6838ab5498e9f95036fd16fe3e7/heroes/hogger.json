{
  "schema_version": 1,
  "id": "hogger",
  "name": "Hogger",
  "role": "Bruiser",
  "overview": "Hogger is a Bruiser with the unique Ability to create and get advantage of impassable terrain with terrain outlines, something that works great in narrow spaces and has low value in wide areas. This characteristic can be used to easily capture Mercenary Camps by strategically aiming Hogg Wild.\n\nThanks to having Rage instead of Mana, Hogger inherently prefers drawn-out battles that tend to exhaust enemy resources, especially when paired with a sustain Healer that can keep him healthy for long periods of time. That said, Hogger has access to a respectable amount of burst damage.",
  "strengths": [
    "Good waveclear",
    "Decent crowd control",
    "Solid damage output, especially when full Rage",
    "Decent mobility",
    "Great at capturing Mercenary Camps"
  ],
  "weaknesses": [
    "Weak to poke damage",
    "Countered by percent-based damage",
    "Cannot deal with high-mobility Heroes",
    "Slightly vulnerable to healing reduction effects"
  ],
