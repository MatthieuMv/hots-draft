  "id": "valla",
  "name": "Valla",
  "role": "Ranged Assassin",
  "overview": "Valla is a highly versatile and flexible ranged damage dealer. Her strong points are her exceptional single-target damage and on-demand area of effect burst damage. However, her relative fragility makes her a high priority target for the enemy.",
  "strengths": [
    "Very high single-target and area of effect damage",
    "Good waveclear",
    "Good poke",
    "Strong in all phases of the game",
    "Flexible Talents that allow her to adapt to many different situations"
  ],
  "weaknesses": [
    "Dependent on good positioning",
    "Low base Health",
    "Vulnerable to crowd control"
  ],
  "synergies": {
