  "id": "nova",
  "name": "Nova",
  "role": "Ranged Assassin",
  "overview": "Nova is a Ranged Assassin capable of using Stealth to confuse opponents and surprise them with ganks. Her strongest point is her exceptional long-ranged single-target burst damage. As a fragile Hero with no mobility tools, Nova needs to position safely and always have a retreat path ready.",
  "strengths": [
    "Holo Decoy to counter some Abilities",
    "Attack Range higher than most other Heroes",
    "Stealthed when out of combat",
    "Good at ganking or just threatening so"
  ],
  "weaknesses": [
    "No mobility tools",
    "Bad siege damage",
    "Extremely poor waveclear",
    "Low base Health",
    "Mana issues"
  ],
  "synergies": {
