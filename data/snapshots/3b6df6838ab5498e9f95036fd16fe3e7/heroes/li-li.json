{
  "schema_version": 1,
  "id": "li-li",
  "name": "Li Li",
  "role": "Healer",
  "overview": "Li Li is a Healer that provides a high amount of sustain healing but a low amount of burst healing, something that makes her particularly good in prolonged team fights and bad in other scenarios, unless she can get some value out of her Blind to mitigate a considerable amount of damage.",
  "strengths": [
    "High sustain healing",
    "Ability to Blind"
  ],
  "weaknesses": [
    "No hard crowd control",
    "Lack of burst healing",
    "Her healing Abilities prioritize Heroes low on Health",
    "Poor waveclear"
  ],
