{
  "schema_version": 1,
  "id": "diablo",
  "name": "Diablo",
  "role": "Tank",
  "overview": "Diablo is an aggressive Tank. With multiple crowd control Abilities that also displace his opponents, he excels at setting up and peeling for his teammates, and punishing poor positioning. Due to how Shadow Charge works, Diablo is particularly strong when enemy Heroes have impassable terrain right behind them.",
  "strengths": [
    "Powerful engage",
    "Very large Health pool",
    "Excellent at body blocking",
    "May respawn very quickly upon death through Black Soulstone",
    "Good self-sustain",
    "High damage against enemy Heroes"
  ],
  "weaknesses": [
    "Limited and conditional mobility",
    "Low waveclear",
    "Requires impassable terrain to shine"
  ],
  "synergies": {
    "heroes": [
