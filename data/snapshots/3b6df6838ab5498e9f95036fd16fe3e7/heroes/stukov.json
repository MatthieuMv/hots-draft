{
  "schema_version": 1,
  "id": "stukov",
  "name": "Stukov",
  "role": "Healer",
  "overview": "Stukov is a high utility solo Healer, who provides excellent zone control. His exceptional healing is reliant on well timed use of Bio-Kill Switch. While his Abilities are very powerful, their use needs to be carefully planned to achieve maximum effect. Stukov has limited mobility, and should not roam by himself. He is designed to assist his allies, and will not perform well without them nearby.",
  "strengths": [
    "Can Silence enemies with Lurking Arm",
    "Capable of exceptional multitarget healing via Bio-Kill Switch and Healing Pathogen",
    "Very strong Basic Attack",
    "Can remove an enemy from team fight range with Massive Shove",
    "Very high skill ceiling, but easy to start learning"
  ],
  "weaknesses": [
    "No mobility",
    "Long cooldown on Bio-Kill Switch",
    "No access to Cleanse or similar tools to remove crowd-control effects",
    "Unable to provide Unstoppable frames"
  ],
  "synergies": {
    "heroes": [
      {
        "id": "raynor",
        "name": "Raynor"
      },
      {
        "id": "e-t-c",
        "name": "E.T.C."
      },
      {
        "id": "sgt-hammer",
        "name": "Sgt. Hammer"
      }
