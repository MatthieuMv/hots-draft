{
  "schema_version": 1,
  "id": "nazeebo",
  "name": "Nazeebo",
  "role": "Ranged Assassin",
  "overview": "Nazeebo is a Mage able to deal a good amount of burst damage and a decent amount of sustained damage from the distance, provided with some crowd control and a high Health pool. While his damage looks decent at any stage of the game, Nazeebo becomes a real threat only in the late game.",
  "strengths": [
    "Decent sustain damage",
    "Good burst damage",
    "Zoning potential",
    "Unique crowd control via Zombie Wall",
    "High maximum Health",
    "Access to Ice Block"
  ],
  "weaknesses": [
    "Weak early game",
    "Zero mobility"
  ],
  "synergies": {
    "heroes": [
      {
        "id": "johanna",
        "name": "Johanna"
      },
      {
        "id": "raynor",
        "name": "Raynor"
      },
      {
        "id": "stukov",
        "name": "Stukov"
      }
    ],
    "explanation": "In order to make Nazeebo work, we recommend picking a Marksman (such as Sylvanas) to guarantee your team a good damage output when your Abilities are on cooldown and a Tank who can provide crowd control (such as Mal'Ganis) that Nazeebo will be able to follow up with Zombie Wall. There are also some Healers who can get value from Zombie Wall after it spawns, usually by adding crowd control (for example Auriel using Detainment Strike)."
  },
  "counters": {
    "heroes": [
      {
        "id": "e-t-c",
        "name": "E.T.C."
      },
      {
        "id": "sylvanas",
        "name": "Sylvanas"
      }
    ],
    "explanation": "Nazeebo is countered by Heroes who can punish his weak early game (such as Sylvanas that can enable her team to push by using Haunting Arrows to disable Structures) and he is rendered almost useless by Heroes who can easily get out from Zombie Wall and eventually dodge his other Abilities (for example E.T.C. can use Face Melt to Knockback the Zombies surrounding himself or a nearby allied Hero)."
  },
