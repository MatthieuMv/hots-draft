{
  "schema_version": 1,
  "id": "whitemane",
  "name": "Whitemane",
  "role": "Healer",
  "overview": "Whitemane is a Healer who can heal her allies with Zeal by damaging her enemies. She is capable of trading damage favourably against most Heroes, and must do so in order to maximise her healing. If she is able to consistently deal damage, she can generate immense healing for her team.",
  "strengths": [
    "High burst healing",
    "Access to a cleanse effect"
  ],
  "weaknesses": [
    "Very poor waveclear and Camp clear",
    "Lack of mobility",
    "Healing output largely dependent on damage dealt, therefore low out-of-combat healing",
    "No crowd control",
    "Weak to healing reduction effects"
  ],
