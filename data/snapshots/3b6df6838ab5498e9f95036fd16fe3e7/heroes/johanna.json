{
  "schema_version": 1,
  "id": "johanna",
  "name": "Johanna",
  "role": "Tank",
  "overview": "Johanna is a low-mobility, extremely resilient Tank, capable of Blinding, Slowing, Stunning, and briefly Pulling enemies. She excels at creating chaos and disruption in the midst of the enemy team for extended periods of time while also peeling for her allies. Johanna is one of the handful of Heroes in the game with no direct counters, and is able to fit into nearly any team composition.",
  "strengths": [
    "High durability",
    "Solid crowd control",
    "Good waveclear",
    "Access to Blinds",
    "Capable of interrupting",
    "On-demand Unstoppable"
  ],
  "weaknesses": [
    "Low damage",
    "No tools to handle high-mobility Heroes",
    "Low mobility",
    "Reliant on the Shield from Iron Skin to survive longer"
  ],
