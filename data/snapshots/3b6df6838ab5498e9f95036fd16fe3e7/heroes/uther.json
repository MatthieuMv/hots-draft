  "id": "uther",
  "name": "Uther",
  "role": "Healer",
  "overview": "Uther is a Healer whose strongest points are his single-target burst healing and reliable crowd control, but his Mana costs are prohibitive for extended team fights and the inability to keep multiple allied Heroes healthy.",
  "strengths": [
    "Strong burst healing",
    "When healing allied Heroes, provides Armor to them",
    "Reliable crowd control",
    "High healing output right after dying (see Devotion)"
  ],
  "weaknesses": [
    "Poor sustain healing and low Mana efficiency",
    "Weak waveclear",
    "Lack of mobility"
  ],
