{
  "schema_version": 1,
  "id": "murky",
  "name": "Murky",
  "role": "Melee Assassin",
  "overview": "Murky is a Melee Assassin that excels at frustrating his opponents. Uniquely designed, he is adept at attracting the attention of enemy players, causing them to behave inefficiently to respond to his abrasive presence. Murky's allies must capitalise on the fact that he thrives in attrition battles; even if his attributes and damage values are limited, his Hero Trait, Spawn Egg, makes it so that he is never away from battle for long when killed.",
  "strengths": [
    "Good waveclear",
    "Strong revival mechanic in the form of Spawn Egg",
    "Has access to Octo-Grab, one of the strongest Heroic Abilities in the game",
    "Abilities have no Mana cost",
    "Generally very threatening late-game presence"
  ],
  "weaknesses": [
    "Extremely fragile; by far the lowest amount of Health amongst all Heroes",
    "Inept at carrying coin-like Objectives, which are dropped on death",
    "Several conditions may limit his damage potential",
    "Underwhelming early-game presence",
    "Distinct playstyle to which your team must adapt"
  ],
