{
  "schema_version": 1,
  "id": "leoric",
  "name": "Leoric",
  "role": "Bruiser",
  "overview": "Leoric is an aggressive melee Bruiser with strong self-sustain and great mobility. He excels at dealing high damage through powerful Basic Attacks and close-range abilities, while his survivability allows him to stand his ground even if outnumbered by several enemies. After taking lethal damage, Undying causes him to turn into a Ghost capable of moving freely and using abilities to slow enemies. After a certain amount of time (influenced by how abilities are used while in Ghost form), Leoric comes back to life at the current location of the Ghost.",
  "strengths": [
    "Good self-sustain",
    "Solid waveclear",
    "Decent mobility",
    "Can deal percent-based damage",
    "Fast respawn thanks to Drain Essence",
    "Can become Unstoppable when needed",
    "Strong in the late game"
  ],
  "weaknesses": [
    "Vulnerable to burst damage",
    "Suffers against healing reduction effects",
    "Weak in the early game"
  ],
  "synergies": {
    "heroes": [
      {
        "id": "diablo",
        "name": "Diablo"
      },
      {
        "id": "orphea",
        "name": "Orphea"
      },
      {
        "id": "stukov",
        "name": "Stukov"
      }
    ],
    "explanation": "Leoric pairs off really well with Heroes who can follow up on his Entomb with a huge amount of burst damage (for example Orphea using Eternal Feast and all her Basic Abilities) or complementary crowd control (such as Lurking Arm by Stukov)."
  },
