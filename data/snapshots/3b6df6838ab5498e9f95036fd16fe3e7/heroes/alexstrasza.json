  "id": "alexstrasza",
  "name": "Alexstrasza",
  "role": "Healer",
  "overview": "Alexstrasza is a Healer who provides raw healing power but does not have access to hard crowd control.\n\nShe is particularly efficient if protected by a solid frontline, since she does not have any real escape mechanism.\n\nDuring important team fights, she uses Dragonqueen to improve her Abilities.",
  "strengths": [
    "Good waveclear",
    "High healing output",
    "Relatively low Mana consumption compared to other Healers",
    "Dragonqueen gives a huge advantage during team fights"
  ],
  "weaknesses": [
    "Limited self-healing capabilities",
    "Lack of crowd-control",
    "Underwhelming mobility",
    "Weak while Dragonqueen is not available",
    "No access to Cleanse or similar tools to remove crowd-control effects",
    "Unable to provide Unstoppable frames"
  ],
